# Supabase publishable key, never a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact origin; production must use HTTPS. No trailing path.
AAA_SITE_ORIGIN=http://127.0.0.1:3100
# Build-time mount path: empty for root, /v2 for LaburSaham staging. Rebuild when changed.
NEXT_PUBLIC_AAA_BASE_PATH=
# Local design preview only. Keep false on any paid/live deployment.
AAA_ENABLE_PREVIEW=false
